<resources>
    <!-- Android 12+: the app takes its colors from the wallpaper (dynamic color), so the splash and the
         widget use the system's Material You palette, mapped to the same Material 3 roles as values/ -->
    <color name="window_background">@android:color/system_neutral1_10</color>
    <color name="widget_surface">@android:color/system_neutral1_50</color>
    <color name="widget_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_on_surface_variant">@android:color/system_neutral2_700</color>
    <color name="widget_badge">@android:color/system_accent1_600</color>
    <color name="widget_on_badge">@android:color/system_accent1_0</color>
    <color name="widget_button">@android:color/system_accent2_100</color>
    <color name="widget_on_button">@android:color/system_accent2_900</color>
</resources>
