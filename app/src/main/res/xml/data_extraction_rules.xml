<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device transfer carry only the app settings -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="notification_blocker_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="notification_blocker_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
