<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: a cream padlock whose keyhole is a crescent moon (quiet hours). Single color, so it
     also works as the themed (monochrome) icon. Inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Shackle -->
    <path
        android:pathData="M43,51V43.5A11,11 0,0 1,65 43.5V51"
        android:strokeColor="#FFFFF6E8"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <!-- Body with a round hole -->
    <path
        android:fillColor="#FFFFF6E8"
        android:fillType="evenOdd"
        android:pathData="M42,49H66A6,6 0,0 1,72 55V73A6,6 0,0 1,66 79H42A6,6 0,0 1,36 73V55A6,6 0,0 1,42 49Z M54,56.5A7.5,7.5 0,1 0,54 71.5A7.5,7.5 0,1 0,54 56.5Z" />
    <!-- Fills most of the hole back: what stays open is a crescent -->
    <path
        android:fillColor="#FFFFF6E8"
        android:pathData="M57.5,54A6.6,6.6 0,1 0,57.5 67.2A6.6,6.6 0,1 0,57.5 54Z" />
</vector>
