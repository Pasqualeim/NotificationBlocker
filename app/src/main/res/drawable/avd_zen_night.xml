<?xml version="1.0" encoding="utf-8"?>
<!-- Zen notification, night: stone lantern with a warm flickering light, twinkling stars, fireflies.
     Used as the indeterminate drawable of a ProgressBar in the zen notification: ProgressBar starts
     (and loops) an animated vector by itself, which a plain ImageView in RemoteViews would not. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">
            <group android:name="frame">
                <clip-path android:pathData="M10,0 H38 A10,10 0 0 1 48,10 V38 A10,10 0 0 1 38,48 H10 A10,10 0 0 1 0,38 V10 A10,10 0 0 1 10,0 Z" />
                <path
                    android:pathData="M10,0 H38 A10,10 0 0 1 48,10 V38 A10,10 0 0 1 38,48 H10 A10,10 0 0 1 0,38 V10 A10,10 0 0 1 10,0 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="0" android:endY="48">
                            <item android:color="#FF0B1238" android:offset="0" />
                            <item android:color="#FF2E4AA0" android:offset="1" />
                        </gradient>
                    </aapt:attr>
                </path>
                <path
                    android:name="stars1"
                    android:pathData="M5.3,8 a0.7,0.7 0 1,0 1.4,0 a0.7,0.7 0 1,0 -1.4,0 M14.3,4 a0.7,0.7 0 1,0 1.4,0 a0.7,0.7 0 1,0 -1.4,0 M26.3,9 a0.7,0.7 0 1,0 1.4,0 a0.7,0.7 0 1,0 -1.4,0 M8.3,19 a0.7,0.7 0 1,0 1.4,0 a0.7,0.7 0 1,0 -1.4,0"
                    android:fillColor="#FFFFF1C1" />
                <path
                    android:name="stars2"
                    android:pathData="M20.4,15 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0 M43.4,20 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0 M32.4,4 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0 M2.4,27 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0"
                    android:fillColor="#FFFFF1C1" />
                <path
                    android:pathData="M33,10 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
                    android:fillColor="#FFF4EEDC" />
                <path
                    android:pathData="M36.3,8.4 a4.3,4.3 0 1,0 8.6,0 a4.3,4.3 0 1,0 -8.6,0"
                    android:fillColor="#FF101A48" />
                <path
                    android:pathData="M0,41 Q24,37 48,41 V48 H0 Z"
                    android:fillColor="#FF1E2A55" />
                <path
                    android:name="lanternGlow"
                    android:pathData="M9,27.5 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0"
                    android:fillColor="#FFFFD27F"
                    android:fillAlpha="0.22" />
                <path
                    android:pathData="M12,45 H28 L26,42 H14 Z"
                    android:fillColor="#FF6B6B78" />
                <path
                    android:pathData="M18,33 H22 V42 H18 Z"
                    android:fillColor="#FF8C8C99" />
                <path
                    android:pathData="M14,31 H26 V33 H14 Z"
                    android:fillColor="#FF5A5A68" />
                <path
                    android:pathData="M15,24 H25 V31 H15 Z"
                    android:fillColor="#FF8C8C99" />
                <path
                    android:name="flame"
                    android:pathData="M17.5,25.5 H22.5 V29.5 H17.5 Z"
                    android:fillColor="#FFFFD27F" />
                <path
                    android:pathData="M9.5,24.5 L13,20 H27 L30.5,24.5 Z"
                    android:fillColor="#FF5A5A68" />
                <path
                    android:pathData="M16.5,20 L20,16.8 L23.5,20 Z"
                    android:fillColor="#FF5A5A68" />
                <path
                    android:pathData="M18.8,15.8 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0"
                    android:fillColor="#FF5A5A68" />
            <group android:name="fly0">
                <path
                    android:name="flyDot0"
                    android:pathData="M34.1,33 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0"
                    android:fillColor="#FFE8FF8A" />
            </group>
            <group android:name="fly1">
                <path
                    android:name="flyDot1"
                    android:pathData="M40.1,39 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0"
                    android:fillColor="#FFE8FF8A" />
            </group>
            <group android:name="fly2">
                <path
                    android:name="flyDot2"
                    android:pathData="M30.1,40 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0"
                    android:fillColor="#FFE8FF8A" />
            </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="stars1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.3"
                android:valueTo="1"
                android:valueType="floatType"
                android:duration="2400"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="stars2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="1"
                android:valueTo="0.3"
                android:valueType="floatType"
                android:duration="2400"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="lanternGlow">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.16"
                android:valueTo="0.34"
                android:valueType="floatType"
                android:duration="1500"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="flame">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.75"
                android:valueTo="1"
                android:valueType="floatType"
                android:duration="650"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="fly0">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="translateX"
                    android:valueFrom="0"
                    android:valueTo="-4"
                    android:valueType="floatType"
                    android:duration="3100"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="0"
                    android:valueTo="-3"
                    android:valueType="floatType"
                    android:duration="2300"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="flyDot0">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.15"
                android:valueTo="1"
                android:valueType="floatType"
                android:duration="1400"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="fly1">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="translateX"
                    android:valueFrom="0"
                    android:valueTo="-3"
                    android:valueType="floatType"
                    android:duration="2700"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="0"
                    android:valueTo="-4"
                    android:valueType="floatType"
                    android:duration="3300"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="flyDot1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="1"
                android:valueTo="0.15"
                android:valueType="floatType"
                android:duration="1700"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="fly2">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="translateX"
                    android:valueFrom="0"
                    android:valueTo="3"
                    android:valueType="floatType"
                    android:duration="3500"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="0"
                    android:valueTo="-2"
                    android:valueType="floatType"
                    android:duration="2100"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="flyDot2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.2"
                android:valueTo="1"
                android:valueType="floatType"
                android:duration="1900"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
</animated-vector>
