<?xml version="1.0" encoding="utf-8"?>
<!-- Zen notification, daytime: sun with slowly turning rays, a light shaft and bamboo in the breeze.
     Used as the indeterminate drawable of a ProgressBar in the zen notification: ProgressBar starts
     (and loops) an animated vector by itself, which a plain ImageView in RemoteViews would not. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">
            <group android:name="frame">
                <clip-path android:pathData="M10,0 H38 A10,10 0 0 1 48,10 V38 A10,10 0 0 1 38,48 H10 A10,10 0 0 1 0,38 V10 A10,10 0 0 1 10,0 Z" />
                <path
                    android:pathData="M10,0 H38 A10,10 0 0 1 48,10 V38 A10,10 0 0 1 38,48 H10 A10,10 0 0 1 0,38 V10 A10,10 0 0 1 10,0 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="0" android:endY="48">
                            <item android:color="#FF3F9BEA" android:offset="0" />
                            <item android:color="#FFBFE6FF" android:offset="1" />
                        </gradient>
                    </aapt:attr>
                </path>
            <group android:name="sunGlow" android:pivotX="32" android:pivotY="14">
                <path
                    android:pathData="M22,14 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"
                    android:fillColor="#FFFFE08A"
                    android:fillAlpha="0.45" />
            </group>
            <group android:name="rays" android:pivotX="32" android:pivotY="14">
                <path
                    android:name="rayPaths"
                    android:pathData="M32,2 L32,4.5 M32,23.5 L32,26 M20,14 L22.5,14 M41.5,14 L44,14 M23.5,5.5 L25.3,7.3 M38.7,20.7 L40.5,22.5 M23.5,22.5 L25.3,20.7 M38.7,7.3 L40.5,5.5"
                    android:strokeColor="#FFFFF1B8"
                    android:strokeWidth="1.3"
                    android:strokeLineCap="round" />
            </group>
                <path
                    android:pathData="M26.5,14 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
                    android:fillColor="#FFFFF6D5" />
                <path
                    android:name="shaft"
                    android:pathData="M29,17 L35,17 L22,48 L10,48 Z"
                    android:fillColor="#FFFFFFFF"
                    android:fillAlpha="0.12" />
                <path
                    android:pathData="M0,40 Q24,35 48,40 V48 H0 Z"
                    android:fillColor="#FF5DB05A" />
            <group android:name="bambooLeft" android:pivotX="8" android:pivotY="48">
                <path
                    android:pathData="M4,-2 H7.2 V48 H4 Z"
                    android:fillColor="#FF6CC24A" />
                <path
                    android:pathData="M10.5,6 H12.9 V48 H10.5 Z"
                    android:fillColor="#FF86D160" />
                <path
                    android:pathData="M4,12 H7.2 M4,24 H7.2 M4,36 H7.2 M10.5,18 H12.9 M10.5,30 H12.9"
                    android:strokeColor="#FF3F8A30"
                    android:strokeWidth="0.8"
                    android:strokeLineCap="round" />
                <path
                    android:pathData="M7,12 Q13,10.5 17,13.5 Q11.5,13.6 7,12 Z M12.5,18 Q18,17 21.5,20.5 Q16.5,20 12.5,18 Z M7,24 Q12,23.5 15,26.5 Q10.5,26 7,24 Z"
                    android:fillColor="#FF4FAE3F" />
                <path
                    android:pathData="M4,12 Q-1,11 -3,14 Q1,13.5 4,12 Z M10.5,30 Q15,29.5 18,32.5 Q14,32 10.5,30 Z"
                    android:fillColor="#FF2F8E3A" />
            </group>
            <group android:name="bambooRight" android:pivotX="42" android:pivotY="48">
                <path
                    android:pathData="M41,4 H44 V48 H41 Z"
                    android:fillColor="#FF6CC24A" />
                <path
                    android:pathData="M41,15 H44 M41,28 H44 M41,40 H44"
                    android:strokeColor="#FF3F8A30"
                    android:strokeWidth="0.8"
                    android:strokeLineCap="round" />
                <path
                    android:pathData="M41,15 Q35,14 31.5,17 Q36.5,16.8 41,15 Z M41,28 Q36,27.5 33,30.5 Q37.5,30 41,28 Z"
                    android:fillColor="#FF4FAE3F" />
                <path
                    android:pathData="M44,20 Q48,19 51,22 Q47,21.5 44,20 Z"
                    android:fillColor="#FF2F8E3A" />
            </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="rays">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="360"
                android:valueType="floatType"
                android:duration="24000"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
    <target android:name="rayPaths">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="0.5"
                android:valueTo="1"
                android:valueType="floatType"
                android:duration="2600"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="sunGlow">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.9"
                    android:valueTo="1.12"
                    android:valueType="floatType"
                    android:duration="3200"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.9"
                    android:valueTo="1.12"
                    android:valueType="floatType"
                    android:duration="3200"
                    android:repeatCount="infinite"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="shaft">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0.06"
                android:valueTo="0.24"
                android:valueType="floatType"
                android:duration="4200"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="bambooLeft">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="-2.5"
                android:valueTo="2.5"
                android:valueType="floatType"
                android:duration="3800"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="bambooRight">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="2"
                android:valueTo="-2"
                android:valueType="floatType"
                android:duration="4400"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
</animated-vector>
